#!/usr/bin/env python3
"""Alert-only token budget watchdog for the tokenomics pilot.

The script is designed for launchd's minimal environment. It resolves Node
without relying on the user's interactive shell PATH, records local state under
Application Support, and emits only syslog warnings for threshold crossings.
"""

from __future__ import annotations

import glob
import json
import logging
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from logging.handlers import SysLogHandler
from pathlib import Path
from typing import Any, Callable, Mapping, Optional


WINDOW = "5h"
ALERT_PCT = 0.75
DEFAULT_COOLDOWN_SECONDS = 1800
HELPER_TIMEOUT_SECONDS = 30
REQUIRED_NODE_MAJOR = 24
# Captured at import time so tests can simulate a failed local syslog
# endpoint (patching SysLogHandler's constructor) without also breaking this
# unrelated priority-constant lookup, which run_cycle() needs regardless of
# whether the endpoint is reachable.
ALERT_SYSLOG_PRIORITY = SysLogHandler.LOG_WARNING


class HelperResult:
    def __init__(self, exit_code: int, stdout: str, stderr: str) -> None:
        self.exit_code = exit_code
        self.stdout = stdout
        self.stderr = stderr


class WatchdogConfig:
    def __init__(
        self,
        *,
        bot: str,
        instance_path: Path,
        ceiling: int,
        cooldown_seconds: int,
        whatsoup_repo: Path,
        node_bin: str,
        state_dir: Path,
    ) -> None:
        self.bot = bot
        self.instance_path = instance_path
        self.ceiling = ceiling
        self.cooldown_seconds = cooldown_seconds
        self.whatsoup_repo = whatsoup_repo
        self.node_bin = node_bin
        self.state_dir = state_dir


def _require_env(env: Mapping[str, str], key: str) -> str:
    value = env.get(key)
    if not value:
        raise ValueError(f"missing {key}")
    return value


def _parse_positive_int(value: str, key: str) -> int:
    try:
        parsed = int(value)
    except ValueError as err:
        raise ValueError(f"{key} must be an integer") from err
    if parsed <= 0:
        raise ValueError(f"{key} must be positive")
    return parsed


def state_dir_name(bot: str) -> str:
    slug = re.sub(r"[^A-Za-z0-9._-]+", "_", bot).strip("._-")
    return f"{(slug or 'bot')[:80]}-tokenomics"


def state_root(env: Mapping[str, str]) -> Path:
    override = env.get("TOKENOMICS_STATE_DIR")
    if override:
        return Path(override)
    bot = _require_env(env, "TOKENOMICS_BOT")
    home = Path(env.get("HOME") or str(Path.home()))
    if sys.platform == "darwin":
        return home / "Library" / "Application Support" / state_dir_name(bot)
    xdg_state = env.get("XDG_STATE_HOME")
    base = Path(xdg_state) if xdg_state else home / ".local" / "state"
    return base / state_dir_name(bot)


def syslog_address() -> str:
    """Local syslog delivery path for this platform.

    SysLogHandler's own default (`("localhost", 514)`, UDP) is not this: a
    UDP send to a port nothing is listening on does not raise, so a caller
    that relied on that default would silently drop every alert instead of
    failing loudly or delivering it. Always resolve to a real local path.
    """
    return "/var/run/syslog" if sys.platform == "darwin" else "/dev/log"


def _default_syslog_fn(priority: int, message: str) -> None:
    # priority is accepted for signature parity with the run_cycle() call
    # site (which always passes SysLogHandler.LOG_WARNING, matching this
    # script's "warnings only" design per its module docstring above).
    del priority
    logger = logging.getLogger("token-budget-watchdog")
    logger.setLevel(logging.WARNING)
    logger.propagate = False
    try:
        handler: logging.Handler = SysLogHandler(address=syslog_address())
    except OSError:
        # No local syslog endpoint (sandboxed/minimal host). Fail open, same
        # as the alert path around it never raising on infrastructure trouble.
        handler = logging.NullHandler()
    logger.addHandler(handler)
    try:
        logger.warning(message)
    finally:
        logger.removeHandler(handler)
        handler.close()


def _node_major(node_bin: str) -> Optional[int]:
    try:
        completed = subprocess.run(
            [node_bin, "-p", "process.versions.node.split('.')[0]"],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if completed.returncode != 0:
        return None
    try:
        return int(completed.stdout.strip())
    except ValueError:
        return None


def _compatible_node(node_bin: str) -> bool:
    major = _node_major(node_bin)
    return major is not None and major >= REQUIRED_NODE_MAJOR


def _version_key(path: str) -> tuple[int, ...]:
    version = Path(path).parents[1].name.removeprefix("v")
    try:
        return tuple(int(part) for part in version.split("."))
    except ValueError:
        return ()


def _node_candidates(env: Mapping[str, str]) -> list[str]:
    candidates: list[str] = []
    repo = env.get("WHATSOUP_REPO")
    home = Path(env.get("HOME") or str(Path.home()))
    if repo:
        try:
            pinned = (Path(repo) / ".nvmrc").read_text(encoding="utf-8").strip()
        except OSError:
            pinned = ""
        if pinned:
            candidates.append(str(home / ".nvm" / "versions" / "node" / f"v{pinned}" / "bin" / "node"))

    found = shutil.which("node")
    if found:
        candidates.append(found)

    nvm_matches = sorted(
        glob.glob(str(home / ".nvm" / "versions" / "node" / "v*" / "bin" / "node")),
        key=_version_key,
        reverse=True,
    )
    candidates.extend(nvm_matches)
    candidates.extend(["/opt/homebrew/bin/node", "/usr/local/bin/node", "node"])
    return candidates


def resolve_node_bin(env: Mapping[str, str]) -> str:
    override = env.get("TOKENOMICS_NODE_BIN")
    if override:
        if not _compatible_node(override):
            raise ValueError(f"TOKENOMICS_NODE_BIN must resolve to Node >= {REQUIRED_NODE_MAJOR}")
        return override

    seen: set[str] = set()
    for candidate in _node_candidates(env):
        if candidate in seen:
            continue
        seen.add(candidate)
        if _compatible_node(candidate):
            return candidate

    raise ValueError(f"no compatible Node >= {REQUIRED_NODE_MAJOR} found")


def load_config(env: Mapping[str, str] = os.environ) -> WatchdogConfig:
    ceiling = _parse_positive_int(_require_env(env, "TOKENOMICS_CEILING"), "TOKENOMICS_CEILING")
    cooldown = _parse_positive_int(
        env.get("TOKENOMICS_ALERT_COOLDOWN_SECONDS", str(DEFAULT_COOLDOWN_SECONDS)),
        "TOKENOMICS_ALERT_COOLDOWN_SECONDS",
    )
    return WatchdogConfig(
        bot=_require_env(env, "TOKENOMICS_BOT"),
        instance_path=Path(_require_env(env, "TOKENOMICS_INSTANCE_PATH")),
        ceiling=ceiling,
        cooldown_seconds=cooldown,
        whatsoup_repo=Path(_require_env(env, "WHATSOUP_REPO")),
        node_bin=resolve_node_bin(env),
        state_dir=state_root(env),
    )


def invoke_token_window(
    config: WatchdogConfig,
    *,
    run_fn: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> HelperResult:
    helper = config.whatsoup_repo / "scripts" / "token-window.ts"
    args = [
        config.node_bin,
        "--experimental-strip-types",
        str(helper),
        "--instance",
        str(config.instance_path),
        "--window",
        WINDOW,
        "--json",
    ]
    try:
        completed = run_fn(
            args,
            text=True,
            capture_output=True,
            check=False,
            cwd=str(config.whatsoup_repo),
            timeout=HELPER_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return HelperResult(124, "", f"token-window timed out after {HELPER_TIMEOUT_SECONDS}s")
    except OSError as err:
        return HelperResult(127, "", f"token-window failed to start: {err}")
    return HelperResult(completed.returncode, completed.stdout, completed.stderr)


def append_history(path: Path, record: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    line = (json.dumps(record, separators=(",", ":")) + "\n").encode("utf-8")
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
    fd = os.open(str(path), flags, 0o600)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)


def _write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_name: Optional[str] = None
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=str(path.parent),
        delete=False,
    ) as handle:
        tmp_name = handle.name
        json.dump(payload, handle, separators=(",", ":"))
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    try:
        os.replace(tmp_name, path)
    except Exception:
        if tmp_name:
            try:
                os.unlink(tmp_name)
            except OSError:
                pass
        raise


def _read_json(path: Path) -> Optional[dict[str, Any]]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (json.JSONDecodeError, OSError):
        return None


def _stderr(message: str) -> None:
    print(f"token-budget-watchdog: {message}", file=sys.stderr)


def _should_alert(config: WatchdogConfig, now: int) -> bool:
    path = config.state_dir / "last-alert.json"
    last = _read_json(path)
    if not last:
        return True
    try:
        last_ts = int(last["ts"])
    except (KeyError, TypeError, ValueError):
        return True
    return now - last_ts >= config.cooldown_seconds


def _parse_helper_payload(helper: HelperResult) -> Optional[dict[str, Any]]:
    try:
        payload = json.loads(helper.stdout)
    except json.JSONDecodeError as err:
        _stderr(f"token-window returned invalid JSON: {err}")
        return None

    sources = payload.get("sources")
    db_source = sources.get("whatsoup_db") if isinstance(sources, dict) else None
    if not isinstance(db_source, dict) or db_source.get("available") is not True:
        _stderr("token-window source unavailable; skipping alert and history")
        return None
    return payload


def run_cycle(
    *,
    env: Mapping[str, str] = os.environ,
    now_fn: Callable[[], float] = time.time,
    syslog_fn: Callable[[int, str], None] = _default_syslog_fn,
    helper_fn: Callable[[WatchdogConfig], HelperResult] = invoke_token_window,
) -> int:
    try:
        config = load_config(env)
    except ValueError as err:
        _stderr(str(err))
        return 0

    helper = helper_fn(config)
    if helper.exit_code != 0:
        detail = helper.stderr.strip() or f"exit {helper.exit_code}"
        _stderr(f"token-window helper failed: {detail}")
        return 0

    payload = _parse_helper_payload(helper)
    if payload is None:
        return 0

    now = int(now_fn())
    try:
        total_tokens = int(payload.get("total_tokens", 0))
    except (TypeError, ValueError):
        _stderr("token-window total_tokens is not an integer")
        return 0

    pct = total_tokens / config.ceiling
    history_record = {
        "ts": now,
        "window_sum": total_tokens,
        "ceiling": config.ceiling,
        "pct": pct,
    }
    try:
        append_history(config.state_dir / "history.jsonl", history_record)
    except OSError as err:
        _stderr(f"history append failed: {err}")
        return 0

    if pct >= ALERT_PCT and _should_alert(config, now):
        syslog_fn(
            ALERT_SYSLOG_PRIORITY,
            (
                f"tokenomics budget warning for {config.bot}: "
                f"{total_tokens}/{config.ceiling} tokens in {WINDOW} ({pct:.1%})"
            ),
        )
        try:
            _write_json_atomic(config.state_dir / "last-alert.json", {"ts": now})
        except OSError as err:
            _stderr(f"last-alert update failed: {err}")
    return 0


def main() -> int:
    return run_cycle()


if __name__ == "__main__":
    raise SystemExit(main())
