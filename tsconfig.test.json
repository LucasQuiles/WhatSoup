{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./.local/typescript/tsconfig.test.tsbuildinfo",
    "types": ["vitest/globals", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "console/src/**/*.ts", "console/src/**/*.tsx", "scripts/**/*.ts"]
}
