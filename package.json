{
  "name": "whatsoup",
  "version": "0.1.0",
  "description": "WhatSoup — consolidated WhatsApp platform with embedded MCP tools",
  "type": "module",
  "engines": {
    "node": ">=23.10.0 <26"
  },
  "volta": {
    "node": "24.15.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "start:instance": "node --experimental-strip-types src/bootstrap.ts",
    "fleet": "node --experimental-strip-types src/fleet/standalone.ts 9099",
    "setup": "bash deploy/setup.sh",
    "auth": "node --experimental-strip-types src/transport/auth.ts",
    "auth:instance": "node --experimental-strip-types src/bootstrap-auth.ts",
    "audit:instance-plugins": "node --experimental-strip-types scripts/audit-instance-plugin-coverage.ts",
    "backfill-enrichment": "node --experimental-strip-types scripts/backfill-enrichment.ts",
    "guard:pre-push": "node --experimental-strip-types scripts/pre-push-guard.ts",
    "guard:doc-drift": "node --experimental-strip-types scripts/doc-drift-check.ts",
    "guard:repo": "node --experimental-strip-types scripts/repo-hygiene-guard.ts",
    "guard:repo:commit-msg": "npm run guard:repo -- --commit-msg",
    "guard:repo:staged": "npm run guard:repo -- --staged",
    "migrate-memory-config": "node --experimental-strip-types scripts/migrate-memory-config.ts",
    "strip-types-compat": "bash scripts/strip-types-compat.sh",
    "pretest": "npm run strip-types-compat",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.test.json",
    "verify:push:branch": "npm run guard:repo:staged && npm run guard:doc-drift && npm run typecheck && npm test -- tests/scripts/repo-hygiene-guard.test.ts tests/scripts/pre-push-guard.test.ts tests/scripts/doc-drift-check.test.ts --pool=forks",
    "verify:release": "npm run guard:doc-drift && npm run typecheck:all && npm test -- --pool=forks",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@mozilla/readability": "0.6.0",
    "@pinecone-database/pinecone": "7.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "cheerio": "1.2.0",
    "linkedom": "0.18.12",
    "openai": "5.23.2",
    "pdf-parse": "2.4.5",
    "pino": "9.14.0",
    "pino-roll": "4.0.0",
    "qrcode-terminal": "0.12.0",
    "sharp": "^0.34.5",
    "ws": "^8.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.15",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.4",
    "framer-motion": "^12.38.0",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "protobufjs": "7.5.6"
  }
}
