{
  "name": "whatsoup",
  "version": "0.1.0",
  "description": "WhatSoup — consolidated WhatsApp platform with embedded MCP tools",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "volta": {
    "node": "24.15.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "start:instance": "node --experimental-strip-types src/bootstrap.ts",
    "fleet": "node --experimental-strip-types src/fleet/standalone.ts 9099",
    "setup": "bash deploy/setup.sh",
    "auth": "node --experimental-strip-types src/transport/auth.ts",
    "auth:instance": "node --experimental-strip-types src/bootstrap-auth.ts",
    "audit:instance-plugins": "node --experimental-strip-types scripts/audit-instance-plugin-coverage.ts",
    "backfill-enrichment": "node --experimental-strip-types scripts/backfill-enrichment.ts",
    "guard:publication": "node --experimental-strip-types scripts/publication-guard.ts",
    "guard:publication:all": "npm run guard:publication -- --all",
    "guard:publication:release": "npm run guard:publication -- --release",
    "guard:publication:staged": "npm run guard:publication -- --staged",
    "guard:pre-push": "node --experimental-strip-types scripts/pre-push-guard.ts",
    "guard:doc-drift": "node --experimental-strip-types scripts/doc-drift-check.ts",
    "guard:public-surface-drift": "node --experimental-strip-types scripts/public-surface-drift-check.ts",
    "guard:work-index": "node --experimental-strip-types scripts/work-index.ts --check",
    "guard:repo": "node --experimental-strip-types scripts/repo-hygiene-guard.ts",
    "guard:repo:release-hygiene": "npm run guard:repo -- --release-hygiene",
    "guard:repo:commit-msg": "npm run guard:repo -- --commit-msg",
    "guard:repo:staged": "npm run guard:repo -- --staged",
    "guard:node-pin-consistency": "node --experimental-strip-types scripts/check-node-pin-consistency.ts",
    "guard:claude-settings": "node --experimental-strip-types scripts/claude-settings-guard.ts --check",
    "guard:test-integrity": "bash scripts/test-integrity-ci.sh",
    "migrate-memory-config": "node --experimental-strip-types scripts/migrate-memory-config.ts",
    "fleet:rotate-token": "node --experimental-strip-types scripts/fleet-rotate-token.ts",
    "leaks:anonymize": "node --experimental-strip-types scripts/anonymize-private-literals.ts",
    "work-index:regen": "node --experimental-strip-types scripts/work-index.ts",
    "strip-types-compat": "bash scripts/strip-types-compat.sh",
    "pretest": "npm run strip-types-compat",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify:push:branch": "unset WHATSOUP_SKIP_DOC_DRIFT WHATSOUP_SKIP_PUBLIC_SURFACE_DRIFT WHATSOUP_SKIP_NODE_PIN_CHECK && npm run guard:repo:staged && npm run guard:publication:staged && npm run guard:doc-drift && npm run guard:public-surface-drift && npm run guard:work-index && npm run guard:node-pin-consistency && npm run guard:claude-settings && npm run typecheck && npm test -- tests/scripts/repo-hygiene-guard.test.ts tests/scripts/pre-push-guard.test.ts tests/scripts/claude-settings-guard.test.ts tests/scripts/doc-drift-check.test.ts tests/scripts/public-surface-drift-check.test.ts tests/scripts/drift-skip-ci-gating.test.ts tests/scripts/work-index.test.ts tests/scripts/node-pin-consistency.test.ts --pool=forks",
    "verify:release": "unset WHATSOUP_SKIP_DOC_DRIFT WHATSOUP_SKIP_PUBLIC_SURFACE_DRIFT WHATSOUP_SKIP_NODE_PIN_CHECK && npm run guard:repo:release-hygiene && npm run guard:publication:all && npm run guard:doc-drift && npm run guard:public-surface-drift && npm run guard:work-index && npm run guard:node-pin-consistency && npm run guard:claude-settings && npm run guard:test-integrity && npm --prefix tools/whatsoup_guard ci && npm --prefix tools/whatsoup_guard run typecheck && npm --prefix tools/whatsoup_guard test && npm --prefix console ci && npm run typecheck:all && npm test -- --pool=forks && npm --prefix console run build",
    "verify:publish": "unset WHATSOUP_SKIP_DOC_DRIFT WHATSOUP_SKIP_PUBLIC_SURFACE_DRIFT WHATSOUP_SKIP_NODE_PIN_CHECK && npm run guard:claude-settings && npm run guard:publication:release && npm run verify:release",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@mozilla/readability": "0.6.0",
    "@pinecone-database/pinecone": "7.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "cheerio": "1.2.0",
    "linkedom": "0.18.12",
    "openai": "5.23.2",
    "pdf-parse": "2.4.5",
    "pino": "9.14.0",
    "pino-roll": "4.0.0",
    "qrcode-terminal": "0.12.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "ws": "^8.20.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.12.4",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.4",
    "framer-motion": "^12.38.0",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "protobufjs": "7.5.6"
  }
}
