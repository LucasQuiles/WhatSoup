users/
groups/

# Logs
*.log
logs/

# Media temp files at the repository root
/media/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git worktrees
.worktrees/

# Duplicate detection catalog
.duplicates/

# Publication/artifact sweep scratch output
.sweep/
.hypothesis/

# SDLC working state (ephemeral — covered by docs/sdlc/ above)
docs/sdlc/active/*/beads/
artifacts/

# Test coverage artifacts (vitest --coverage)
coverage/

# Python test/runtime caches
__pycache__/
.pytest_cache/

# Editor/manual backup files
*.bak

# Temporary build/debug artifacts
output.txt
bead-output.md
codex-exec-deep-dive.md

# Browser test failure screenshots (vitest browser screenshotFailures: true)
# Never commit — CI artifacts are uploaded separately; local screenshots are noise.
tests/browser/__screenshots__/
# vitest 4 attachment artifacts (failure screenshots routed through the attachments API)
.vitest-attachments/

# pytest-cov data file
.coverage
.coverage.*

# Local-only tooling (never tracked — contains host-specific paths/identifiers)
.local/
