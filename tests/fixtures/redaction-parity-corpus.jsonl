{"id": "neg-environment-dotfile", "class": "negative:benign-dotfile", "input": ".environment", "expected": ".environment"}
{"id": "m1-prefixed-compound-leak", "class": "fixed:prefixed-compound-anchor", "input": "user_access_token=leakvalue123", "expected": "user_access_token=[REDACTED]", "rationale": "BEAD-055 (fixed): a `_`-prefixed compound key (`user_access_token=`) is now anchored by the optional `(?:[A-Za-z0-9]*_)?` segment placed before the known secret keys in BOTH `KEYED_SECRET_RE` (Python SSOT) and `SECRETISH_ASSIGNMENT` (TS), so the `access_token` tail matches and the value is masked byte-identically in both runtimes. Previously the `(^|[^A-Za-z0-9_]|\\n)` prefix class excluded the leading `_`, so both leaked."}
{"id": "bead054-redis-userinfo", "class": "regress:url-userinfo-scheme", "input": "redis://user:pass@host", "expected": "redis://[REDACTED]@host", "rationale": "BEAD-054: non-http URL creds must mask. TS previously used `https?://`-only and leaked `redis://` creds; both runtimes now use the bounded any-scheme `[a-z][a-z0-9+.-]{0,30}://` form. Byte-identical TS=Py."}
{"id": "bead054-wss-userinfo", "class": "regress:url-userinfo-scheme", "input": "wss://user:pass@host", "expected": "wss://[REDACTED]@host", "rationale": "BEAD-054: `wss://` creds masked by the bounded any-scheme URL_USERINFO form in both runtimes. Byte-identical TS=Py."}
{"id": "neg-event-count", "class": "negative:benign-compound", "input": "event_count=42", "expected": "event_count=42", "rationale": "BEAD-055 over-mask guard: `event_count` has no secret-key tail (`count` is not a known key), so the optional `(?:[A-Za-z0-9]*_)?` prefix must NOT anchor it. Unchanged in both runtimes."}
{"id": "neg-message-id", "class": "negative:benign-compound", "input": "message_id=abc123", "expected": "message_id=abc123", "rationale": "BEAD-055 over-mask guard: `message_id` tail `id` is not a secret key. Unchanged in both runtimes."}
{"id": "neg-user-id", "class": "negative:benign-compound", "input": "user_id=42", "expected": "user_id=42", "rationale": "BEAD-055 over-mask guard: `user_id` tail `id` is not a secret key. Unchanged in both runtimes."}
{"id": "neg-retry-count", "class": "negative:benign-compound", "input": "retry_count=5", "expected": "retry_count=5", "rationale": "BEAD-055 over-mask guard: `retry_count` tail `count` is not a secret key. Unchanged in both runtimes."}
{"id": "parity-keyed-phone-underscore", "class": "regress:phone-keyed-underscore", "input": "msisdn_12025550181", "expected": "msisdn_[REDACTED PHONE]", "rationale": "L3-001: TS KEYED_PHONE_LIKE separator must accept `_` (Python SSOT uses [\\s_-]+). Underscore-keyed phone must redact in both runtimes."}
{"id": "parity-keyed-phone-underscore-plus", "class": "regress:phone-keyed-underscore", "input": "phone_+12025550181", "expected": "phone_[REDACTED PHONE]", "rationale": "L3-001: underscore separator with leading + — redacts in both runtimes."}
{"id": "parity-context-phone-underscore", "class": "regress:phone-context-underscore", "input": "sent for_+12025550181 now", "expected": "sent for_[REDACTED PHONE] now", "rationale": "L3-001: TS CONTEXT_PHONE_LIKE separator must accept `_` (Python SSOT uses [\\s_-]+)."}
{"id": "parity-bearer-lowercase", "class": "regress:bearer-case", "input": "request bearer sk-abc123def456GHI", "expected": "request bearer [REDACTED]", "rationale": "L3-002: TS BEARER_VALUE must be case-insensitive like Python (re.IGNORECASE); lowercase bearer token must redact."}
