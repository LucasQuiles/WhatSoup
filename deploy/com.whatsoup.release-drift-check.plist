<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whatsoup.release-drift-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WHATSOUP_REPO_ROOT__/scripts/run-with-pinned-node.sh</string>
    <string>__WHATSOUP_REPO_ROOT__/scripts/live-release-drift-alert.ts</string>
    <string>--launchd-plist</string>
    <string>__HOME__/Library/LaunchAgents/com.whatsoup.__INSTANCE__.plist</string>
    <string>--instance</string>
    <string>__INSTANCE__</string>
    <string>--source</string>
    <string>release-drift</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>WorkingDirectory</key>
  <string>__WHATSOUP_REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/whatsoup/release-drift-check.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/whatsoup/release-drift-check.err.log</string>
</dict>
</plist>
