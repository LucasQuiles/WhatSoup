[Unit]
Description=BOT ERRORS Q coordination loop
After=network-online.target whatsoup-fleet.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/whatsoup/bot-errors.env
ExecStart=/usr/bin/python3 %h/LAB/WhatSoup/deploy/scripts/bot-errors-q-loop.py
Restart=always
RestartSec=10
WorkingDirectory=%h/LAB/WhatSoup

[Install]
WantedBy=default.target
