[Unit]
Description=BOT ERRORS durable outbox dispatcher
After=network-online.target whatsoup-fleet.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/whatsoup/bot-errors.env
WorkingDirectory=%h/LAB/WhatSoup
ExecStart=/usr/bin/python3 %h/LAB/WhatSoup/deploy/scripts/bot-errors-dispatcher.py --daemon --interval 30 --max-events 25
Restart=always
RestartSec=10
SyslogIdentifier=bot-errors-dispatcher

[Install]
WantedBy=default.target
