# BOT ERRORS routing configuration.
# Copy to ~/.config/whatsoup/bot-errors.env and fill host-local values.
#
# Keep this file placeholder-only. Real chat IDs, socket paths, and database
# paths belong in the private host env file, not tracked repo text.

BOT_ERRORS_JID=120363555555555000@g.us
BOT_ERRORS_EXPECTED_JID=120363555555555000@g.us
# Fail-closed routing gate (default ENABLED). When enabled, live dispatch refuses
# to start unless BOT_ERRORS_EXPECTED_JID is set and equals BOT_ERRORS_JID — a
# drift guard against misrouted alerts on a fresh host. Set to 0/false/no/off to
# allow dispatch against BOT_ERRORS_JID without the pin. See docs/configuration.md.
BOT_ERRORS_REQUIRE_EXPECTED=1
BOT_ERRORS_SOCKET_PATH=/run/user/1000/whatsoup/instance/whatsoup.sock
BOT_ERRORS_SOCKET=/run/user/1000/whatsoup/instance/whatsoup.sock
BOT_ERRORS_DB=/var/lib/whatsoup/instance/bot.db
BOT_ERRORS_HEALTH_PROFILE=/var/lib/whatsoup/health-profile.json
# Collector poll list (host-local). The tracked systemd unit carries no --remote
# flags; the collector reads this comma-separated host list instead, so fleet
# topology never enters the public repo. Empty/unset fails closed (exit 64) — the
# collector never silently polls nothing. Replace the placeholders with the real
# hosts this collector should reach (see deploy/bot-errors-collector.service).
BOT_ERRORS_RELAY_REMOTES=host-a,host-b,host-c
