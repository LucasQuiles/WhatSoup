# BOT ERRORS routing configuration.
# Copy to ~/.config/whatsoup/bot-errors.env and fill host-local values.
#
# Keep this file placeholder-only. Real chat IDs, socket paths, and database
# paths belong in the private host env file, not tracked repo text.

BOT_ERRORS_JID=120363555555555000@g.us
BOT_ERRORS_SOCKET_PATH=/run/user/1000/whatsoup/instance/whatsoup.sock
BOT_ERRORS_SOCKET=/run/user/1000/whatsoup/instance/whatsoup.sock
BOT_ERRORS_DB=/var/lib/whatsoup/instance/bot.db
BOT_ERRORS_HEALTH_PROFILE=/var/lib/whatsoup/health-profile.json
