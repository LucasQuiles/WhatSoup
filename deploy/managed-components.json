{
  "schema_version": 1,
  "npm": {
    "cooldown_minutes": 10080,
    "npmrc_min_release_age_days": 7,
    "npmrc": "deploy/npmrc.hardened",
    "safe_install_args": [
      "--ignore-scripts",
      "--global-style=false"
    ],
    "codex_node": {
      "node_bin": "$HOME/.nvm/versions/node/v24.13.0/bin",
      "npm_min_version": "11.12.0"
    }
  },
  "tier1": [
    {
      "name": "claude",
      "kind": "native",
      "update": [
        "claude",
        "install",
        "latest"
      ],
      "rollback": [
        "claude",
        "install",
        "{previous}"
      ],
      "smoke": [
        "claude",
        "--version"
      ]
    },
    {
      "name": "codex",
      "kind": "npm-global",
      "package": "@openai/codex",
      "node_bin": "$HOME/.nvm/versions/node/v24.13.0/bin",
      "update": [
        "npm",
        "install",
        "-g",
        "@openai/codex@{target}",
        "--ignore-scripts"
      ],
      "rollback": [
        "npm",
        "install",
        "-g",
        "@openai/codex@{previous}",
        "--ignore-scripts"
      ],
      "smoke": [
        "codex",
        "--version"
      ]
    },
    {
      "name": "opencode",
      "kind": "npm-global",
      "package": "opencode-ai",
      "update": [
        "npm",
        "install",
        "-g",
        "opencode-ai@{target}",
        "--ignore-scripts"
      ],
      "rollback": [
        "npm",
        "install",
        "-g",
        "opencode-ai@{previous}",
        "--ignore-scripts"
      ],
      "smoke": [
        "opencode",
        "--version"
      ]
    }
  ],
  "tier2": {
    "probes": [
      {
        "name": "npm-global",
        "mode": "detect-only",
        "nodes": [
          "24.13.0",
          "24.15.0"
        ]
      },
      {
        "name": "claude-plugins",
        "mode": "detect-only",
        "paths": [
          "$HOME/.claude/plugins"
        ]
      },
      {
        "name": "mcp-servers",
        "mode": "detect-only",
        "commands": [
          "claude mcp list",
          "npx @playwright/mcp@latest"
        ]
      },
      {
        "name": "local-bin",
        "mode": "detect-only",
        "binaries": [
          "pinecone-mcp",
          "google-workspace-mcp",
          "playwright-mcp",
          "sentry-mcp",
          "whatsapp-mcp"
        ]
      },
      {
        "name": "apt",
        "mode": "detect-only",
        "packages": [
          "gh",
          "jq",
          "ripgrep",
          "sqlite3",
          "git",
          "ffmpeg",
          "google-chrome-stable"
        ]
      },
      {
        "name": "runtime",
        "mode": "detect-only",
        "commands": [
          "node --version",
          "npm --version",
          "python3 --version"
        ]
      },
      {
        "name": "systemd-units",
        "mode": "detect-only",
        "units": [
          "whatsoup-fleet.service",
          "whatsoup-reply-guarantee.timer",
          "harness-maintenance.timer"
        ]
      }
    ]
  },
  "protective_services": {
    "description": "macOS LaunchAgent services that guard bot availability and data durability. Each entry documents the template in deploy/templates/, the install path pattern, and the liveness probe.",
    "entries": [
      {
        "name": "BOT-watchdog",
        "label_pattern": "com.whatsoup.{BOT_NAME}-watchdog",
        "template": "deploy/templates/com.whatsoup.BOT-watchdog.plist",
        "script_template": "deploy/templates/watchdog-script.sh",
        "install_path": "~/Library/LaunchAgents/com.whatsoup.{BOT_NAME}-watchdog.plist",
        "script_install_path": "~/.local/bin/{BOT_NAME}-watchdog",
        "schedule": "StartInterval 120s",
        "run_at_load": true,
        "keep_alive": false,
        "purpose": "Monitors bot and fleet-console health endpoints every 2 minutes; restarts stalled launchd jobs with a 5-minute cooldown to prevent restart storms.",
        "verified_hosts": [
          "mini7",
          "mini8",
          "mini9"
        ],
        "probe": "launchctl print gui/$(id -u)/com.whatsoup.{BOT_NAME}-watchdog"
      },
      {
        "name": "reply-guarantee",
        "label_pattern": "com.whatsoup.reply-guarantee",
        "template": "deploy/templates/com.whatsoup.reply-guarantee.plist",
        "install_path": "~/Library/LaunchAgents/com.whatsoup.reply-guarantee.plist",
        "schedule": "StartInterval 60s",
        "run_at_load": true,
        "keep_alive": false,
        "purpose": "Drains the stuck-replies queue every 60 seconds, ensuring reply-guarantee delivery even if the bot's in-process retry path was interrupted.",
        "node_pin_required": true,
        "node_pin_note": "Template corrected from origin/main: /usr/bin/env node replaced with pinned absolute path. The ambient Homebrew node tracks major upgrades silently \u2014 see mini7 incident 2026-05-27/2026-06-09 in docs/runbooks/macos-host-setup.md.",
        "probe": "launchctl print gui/$(id -u)/com.whatsoup.reply-guarantee"
      },
      {
        "name": "ms365-token-backup",
        "label_pattern": "com.whatsoup.ms365-token-backup",
        "template": "deploy/templates/com.whatsoup.ms365-token-backup.plist",
        "script_template": "deploy/templates/ms365-token-backup.sh",
        "install_path": "~/Library/LaunchAgents/com.whatsoup.ms365-token-backup.plist",
        "script_install_path": "~/.local/bin/ms365-token-backup",
        "schedule": "StartCalendarInterval 03:00 daily",
        "run_at_load": true,
        "keep_alive": false,
        "purpose": "Backs up ~/.ms365-mcp/token-cache.json and selected-account.json daily, retaining 14 copies. Allows token recovery after accidental deletion or plugin upgrade that clears the token store.",
        "applicable_hosts": "Hosts running M365 MCP bots (ml-bot/mini8, ew-bot/mini9 and any future M365-integrated bots).",
        "probe": "ls -lt ~/.ms365-mcp-backups/ | head -5"
      }
    ]
  }
}
