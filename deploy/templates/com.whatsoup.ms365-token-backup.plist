<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: com.whatsoup.ms365-token-backup.plist
  Replace before installing:
    USERNAME  — macOS user account (e.g. mlerer, eweintraub)

  Install path: ~/Library/LaunchAgents/com.whatsoup.ms365-token-backup.plist
  Script path:  ~/.local/bin/ms365-token-backup  (see ms365-token-backup.sh template)

  After installing:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.whatsoup.ms365-token-backup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whatsoup.ms365-token-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/ms365-token-backup</string>
  </array>

  <!-- Run once immediately on bootstrap (captures current token state). -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Daily at 03:00 local time. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/whatsoup-logs/ms365-backup.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/whatsoup-logs/ms365-backup.err</string>
</dict>
</plist>
