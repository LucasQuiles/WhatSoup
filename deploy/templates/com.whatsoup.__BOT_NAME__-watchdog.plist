<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: com.whatsoup.BOT-watchdog.plist
  Replace every placeholder before installing:
    __BOT_NAME__      — e.g. rb-bot, ml-bot, ew-bot
    USERNAME      — macOS user account for this bot (e.g. rachel, mlerer, eweintraub)

  Install path: ~/Library/LaunchAgents/com.whatsoup.__BOT_NAME__-watchdog.plist
  Script path:  ~/.local/bin/__BOT_NAME__-watchdog  (see watchdog-script.sh template)

  After installing, load without rebooting:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.whatsoup.__BOT_NAME__-watchdog.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whatsoup.__BOT_NAME__-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/__BOT_NAME__-watchdog</string>
  </array>

  <!-- Check every 2 minutes. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <!--
    RunAtLoad=true: run once immediately when bootstrapped (catches a
    down-bot without waiting for the first interval).
  -->
  <key>RunAtLoad</key>
  <true/>

  <!--
    KeepAlive=false: the watchdog is a one-shot timer job, not a daemon.
    launchd re-fires it on the next StartInterval tick.
  -->
  <key>KeepAlive</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/whatsoup/__BOT_NAME__-watchdog.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/whatsoup/__BOT_NAME__-watchdog.launchd.err.log</string>
</dict>
</plist>
