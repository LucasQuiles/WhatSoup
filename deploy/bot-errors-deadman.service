[Unit]
Description=BOT ERRORS dispatcher deadman
After=network-online.target bot-errors-dispatcher.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/LAB/WhatSoup
EnvironmentFile=%h/.config/whatsoup/bot-errors.env
ExecStart=/usr/bin/python3 %h/LAB/WhatSoup/deploy/scripts/bot-errors-health-check.py --deadman --max-state-age 180
SyslogIdentifier=bot-errors-deadman
