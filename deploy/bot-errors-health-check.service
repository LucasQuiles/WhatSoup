[Unit]
Description=BOT ERRORS daily capability/config health check
After=network-online.target bot-errors-dispatcher.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/LAB/WhatSoup
Environment=BOT_ERRORS_HEALTH_PROFILE=%h/LAB/WhatSoup/deploy/health-profiles/nucles.json
ExecStart=/usr/bin/python3 %h/LAB/WhatSoup/deploy/scripts/bot-errors-runner.py --instance bot-errors-health --source service-exit --summary "BOT ERRORS daily health command failed" --log-hint "journalctl --user -u bot-errors-health-check.service --since '30 minutes ago'" -- /usr/bin/python3 %h/LAB/WhatSoup/deploy/scripts/bot-errors-health-check.py --daily
SyslogIdentifier=bot-errors-health-check
