[Unit]
Description=WhatSoup Fleet Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Pre-install the .nvmrc-pinned Node via nvm if available. No-op on hosts
# without nvm. The wrapper's version gate (deploy/whatsoup, PR #663) is the
# actual safety net at exec time.
#
# Concurrent invocations (multiple template instances starting after reboot)
# share ~/.nvm. nvm has no file locking on version directories. For the
# common case (version already installed) install is a trivial no-op with no
# fs writes. For the cold-boot case (version not present), concurrent
# extracts to ~/.nvm/versions/node/vX.Y.Z/ can race. Risk is accepted: if an
# install fails on one instance the systemd Restart=on-failure picks it up,
# by which point a sibling instance has typically completed the install.
ExecStartPre=%h/.local/bin/whatsoup-ensure-node
ExecStart=%h/.local/bin/whatsoup-fleet 9099
Restart=on-failure
RestartSec=5
Environment=NODE_OPTIONS=--experimental-strip-types

[Install]
WantedBy=default.target
