[Unit]
Description=WhatSoup release drift+currency observer (Linux parity for com.whatsoup.release-drift-check.plist)
Documentation=https://github.com/LucasQuiles/WhatSoup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/whatsoup/bot-errors.env
# WHATSOUP_RELEASE_DRIFT_INSTANCE, the BOT ERRORS instance label of this host's
# release alerts, comes from its own file and never from bot-errors.env, which
# every BOT ERRORS unit loads. deploy/setup.sh writes this name to that file and
# nowhere else. The wrapper never reads WHATSOUP_INSTANCE, which bot-errors.env,
# the user manager or a drop-in can set for per-instance agent state. A later
# file overrides an earlier one, and the "-" lets a missing file reach the
# wrapper, whose exit 2 fails the unit.
EnvironmentFile=-%h/.config/whatsoup/release-drift.env
ExecStart=%h/.local/bin/whatsoup-release-drift-linux.sh
# Exit statuses of deploy/scripts/whatsoup-release-drift-linux.sh:
#   0 clean, or the deployed release differs from the target ref. A differing
#     target is advisory: its currency finding goes through the BOT ERRORS
#     outbox, and the unit stays green.
#   1 integrity drift. The observer has emitted the alert through the BOT ERRORS
#     outbox (the dispatcher suppresses duplicates while the incident is open),
#     so the outbox is the single alert channel and the unit stays green.
#   2 inconclusive, and the unit fails (systemctl --user and the journal show
#     it): the label is missing or unsafe; the launcher resolves into no
#     release; the release's runner or observer failed; the currency check was
#     inconclusive (no release manifest, a network failure or a timeout), which
#     still emits its alert; either outbox emit failed; or exit 1 came from a
#     release whose scheduler predates --bootstrap-exit-code 2.
# The observer needs ~/.local/bin/whatsoup to point into an exported release
# that holds .whatsoup-release-manifest.json. deploy/setup.sh points it at the
# tree setup runs from, so on a host installed from a clone every run raises
# manifest-missing and inconclusive alerts and exits 2.
SuccessExitStatus=0 1
Nice=10
