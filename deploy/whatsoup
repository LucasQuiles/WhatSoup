#!/usr/bin/env bash
set -euo pipefail

# WhatSoup — multi-instance wrapper
# Usage: whatsoup <instance-name>
#
# Agent instances (type: "agent") use Claude Code's native auth (Max/Pro subscription).
# Chat instances (type: "chat") use API keys from system keyring or env vars.

INSTANCE="${1:?Usage: whatsoup <instance-name>}"

# POSIX-portable symlink resolution (readlink -f is GNU-only, unavailable on macOS)
_resolve_symlinks() {
  local p="$1"
  while [ -L "$p" ]; do
    local dir="$(cd "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    [[ "$p" != /* ]] && p="$dir/$p"
  done
  echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}

# Cross-platform keyring lookup.
# Normal lookups prefer env vars. Scoped lookups prefer the keyring first so a
# shared env var cannot shadow an instance-specific token.
keyring_lookup() {
  local service="$1"
  local envvar="${2:-}"
  shift 2 || true
  local account="$USER"
  local env_first=true
  if [ "$service" = "whatsoup-health-token" ] || [ "$service" = "whatsoup_health" ]; then
    env_first=false
  fi
  if [ "${1:-}" = "user" ] && [ -n "${2:-}" ]; then
    account="$2"
    env_first=false
  fi
  # Prefer already-set environment variable for service-wide lookups.
  if [ "$env_first" = "true" ] && [ -n "$envvar" ] && [ -n "${!envvar:-}" ]; then
    echo "${!envvar}"
    return
  fi
  local keyring_value=""
  case "$(uname -s)" in
    Darwin) keyring_value="$(security find-generic-password -s "$service" -a "$account" -w 2>/dev/null || true)" ;;
    *)      keyring_value="$(timeout 3s secret-tool lookup service "$service" "$@" 2>/dev/null || true)" ;;
  esac
  if [ -n "$keyring_value" ]; then
    echo "$keyring_value"
    return
  fi
  if [ "$env_first" != "true" ] && [ -n "$envvar" ] && [ -n "${!envvar:-}" ]; then
    echo "${!envvar}"
    return
  fi
}

# Pinned Node path (DES-007: don't rely on PATH in user units).
# Resolve through symlinks so REPO_ROOT points to the actual repo.
# The default Node binary is derived from .nvmrc at runtime so this wrapper
# tracks the repo's single source of truth (see scripts/check-node-pin-consistency.ts).
SCRIPT_DIR="$(cd "$(dirname "$(_resolve_symlinks "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
NVMRC_VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/.nvmrc" 2>/dev/null || true)"
if [ -z "$NVMRC_VERSION" ]; then
  echo "FATAL: cannot read Node version from $REPO_ROOT/.nvmrc" >&2
  exit 1
fi
# Gate requires a dotted version (e.g. 24.15.0) for the -lt arithmetic
# comparison. lts/iron, latest, or any non-numeric leading value would
# silently disable the gate.
if ! printf '%s' "$NVMRC_VERSION" | grep -qE '^[0-9]'; then
  echo "FATAL: .nvmrc must be a dotted version (e.g. 24.15.0), not '$NVMRC_VERSION'" >&2
  exit 1
fi
DEFAULT_NODE="$HOME/.nvm/versions/node/v${NVMRC_VERSION}/bin/node"
NODE="${WHATSOUP_NODE:-$DEFAULT_NODE}"
if [ ! -x "$NODE" ]; then
  # Do NOT fall back to system node — it likely lacks --experimental-strip-types
  # and would burn through systemd restart budget with repeated failures.
  echo "FATAL: node v${NVMRC_VERSION} not found at $NODE. Set WHATSOUP_NODE or run: nvm install ${NVMRC_VERSION}" >&2
  exit 1
fi

# Version-compatibility gate: the entrypoint passes --experimental-strip-types,
# which requires Node >= 22.6 (and the repo pins a specific major via .nvmrc).
# Without this gate, a wrapper that resolved to a too-old Node via the
# command -v fallback would exec, hit status 9 on the unknown option, and
# crash-loop under systemd. See incident 2026-05-18 17:12 EDT.
required_major="${NVMRC_VERSION%%.*}"
engine_max_exclusive_major="$("$NODE" -e '
const fs = require("fs");
const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
const range = pkg.engines && pkg.engines.node;
if (typeof range !== "string") process.exit(2);
const match = range.match(/<\s*(\d+)/);
if (!match) process.exit(3);
process.stdout.write(match[1]);
' "$REPO_ROOT/package.json" 2>/dev/null || true)"
if ! printf '%s' "$engine_max_exclusive_major" | grep -qE '^[0-9]+$'; then
  echo "FATAL: cannot parse package.json#engines.node upper bound from $REPO_ROOT/package.json (expected range like >=24.0.0 <26)" >&2
  exit 1
fi
node_major="$("$NODE" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if ! printf '%s' "$node_major" | grep -qE '^[0-9]+$' \
  || [ "$node_major" -lt "$required_major" ] \
  || [ "$node_major" -ge "$engine_max_exclusive_major" ]; then
  resolved_version="$("$NODE" --version 2>/dev/null || echo "unknown")"
  cat >&2 <<EOF
FATAL: resolved Node is incompatible with WhatSoup entrypoint
  Pinned (.nvmrc):             v${NVMRC_VERSION} (default runtime)
  Declared compatibility:      package.json#engines.node requires major >= ${required_major} and < ${engine_max_exclusive_major}
  Resolved:                    ${NODE}
  Version:                     ${resolved_version}

The entrypoint requires Node >= 22.6 for native TypeScript stripping.
A resolved Node outside package.json#engines.node is unsupported by the repo's CI and dependency policy.

Install the pinned version on this host:
  . \$HOME/.nvm/nvm.sh && nvm install ${NVMRC_VERSION}

Or override with WHATSOUP_NODE=/path/to/compatible/node.
EOF
  exit 1
fi

# Ensure PATH includes locations needed by agent instances (claude CLI, tools)
export PATH="$HOME/.local/bin:$(dirname "$NODE"):$PATH"

# Pin process temp files under a per-instance WhatSoup-owned tmp directory so
# Baileys encrypted upload blobs are not exposed to macOS /var/folders cleanup.
XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
TMPDIR="$XDG_DATA/whatsoup/tmp/$INSTANCE"
mkdir -p "$TMPDIR"
chmod 700 "$TMPDIR"
export TMPDIR

# Detect instance type from instance.json (whatsoup-instances namespace)
XDG_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
INSTANCE_JSON="$XDG_CONFIG/whatsoup/instances/$INSTANCE/config.json"
INSTANCE_TYPE="chat"
if [ -f "$INSTANCE_JSON" ]; then
  INSTANCE_TYPE="$($NODE -e "process.stdout.write(JSON.parse(require('fs').readFileSync('$INSTANCE_JSON','utf8')).type ?? 'chat')")"
fi

if [ "$INSTANCE_TYPE" = "chat" ]; then
  # Chat instances need API keys for direct LLM calls
  ANTHROPIC_API_KEY="$(keyring_lookup anthropic ANTHROPIC_API_KEY)"
  OPENAI_API_KEY="$(keyring_lookup openai OPENAI_API_KEY)"
  PINECONE_API_KEY="$(keyring_lookup pinecone PINECONE_API_KEY)"

  fail_if_empty() {
    local name="$1" val="$2"
    if [ -z "$val" ]; then
      echo "FATAL: $name key is empty or missing from keyring" >&2
      echo "  Linux:  secret-tool store --label='$name' service $name <<<'YOUR_KEY'" >&2
      echo "  macOS:  security add-generic-password -s $name -a \$USER -w 'YOUR_KEY'" >&2
      echo "  Either: export $(echo "$name" | tr '[:lower:]' '[:upper:]')_API_KEY=YOUR_KEY" >&2
      exit 1
    fi
  }

  fail_if_empty "anthropic" "$ANTHROPIC_API_KEY"
  fail_if_empty "openai" "$OPENAI_API_KEY"
  fail_if_empty "pinecone" "$PINECONE_API_KEY"

  export ANTHROPIC_API_KEY OPENAI_API_KEY PINECONE_API_KEY
else
  # Agent and passive instances: no ANTHROPIC_API_KEY (would override subscription billing).
  # OPENAI_API_KEY is needed by agent instances for Whisper audio transcription when users
  # send voice notes. Passive instances don't call any LLM APIs and the key is harmless.
  unset ANTHROPIC_API_KEY 2>/dev/null || true
  OPENAI_API_KEY="$(keyring_lookup openai OPENAI_API_KEY)"
  if [ -n "$OPENAI_API_KEY" ]; then
    export OPENAI_API_KEY
  fi

  # PINECONE_API_KEY is needed by agent instances with pineconeAllowedIndexes for
  # the knowledge_search MCP tool. The tool runs in the WhatSoup process (not the
  # Claude Code subprocess), so the key must be in this parent process.
  PINECONE_API_KEY="$(keyring_lookup pinecone PINECONE_API_KEY)"
  if [ -n "$PINECONE_API_KEY" ]; then
    export PINECONE_API_KEY
  fi
fi

# Health server auth token — used by POST /heal and POST /send on all instances.
# Prefer an already-loaded value (e.g. from EnvironmentFile=tokens.env in the systemd unit) so a
# missing or unresponsive platform keyring cannot delay startup.
if [ -z "${WHATSOUP_HEALTH_TOKEN:-}" ]; then
  WHATSOUP_HEALTH_TOKEN="$(keyring_lookup whatsoup-health-token "" user "$INSTANCE")"
  if [ -z "$WHATSOUP_HEALTH_TOKEN" ]; then
    WHATSOUP_HEALTH_TOKEN="$(keyring_lookup whatsoup_health WHATSOUP_HEALTH_TOKEN)"
  fi
fi
if [ -n "$WHATSOUP_HEALTH_TOKEN" ]; then
  export WHATSOUP_HEALTH_TOKEN
fi

exec "$NODE" \
  --disable-warning=ExperimentalWarning \
  --experimental-strip-types \
  "$REPO_ROOT/src/bootstrap.ts" "$INSTANCE"
