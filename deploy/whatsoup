#!/usr/bin/env bash
set -euo pipefail

# WhatSoup — multi-instance wrapper
# Usage: whatsoup <instance-name>
#
# Agent instances (type: "agent") use Claude Code's native auth (Max/Pro subscription).
# Chat instances (type: "chat") use API keys from system keyring or env vars.

INSTANCE="${1:?Usage: whatsoup <instance-name>}"

# POSIX-portable symlink resolution (readlink -f is GNU-only, unavailable on macOS)
_resolve_symlinks() {
  local p="$1"
  while [ -L "$p" ]; do
    local dir="$(cd "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    [[ "$p" != /* ]] && p="$dir/$p"
  done
  echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}

# Cross-platform keyring lookup.
# Normal lookups prefer env vars. Scoped lookups prefer the keyring first so a
# shared env var cannot shadow an instance-specific token.
keyring_lookup() {
  local service="$1"
  local envvar="${2:-}"
  shift 2 || true
  local account="$USER"
  local env_first=true
  if [ "$service" = "whatsoup-health-token" ] || [ "$service" = "whatsoup_health" ]; then
    env_first=false
  fi
  if [ "${1:-}" = "user" ] && [ -n "${2:-}" ]; then
    account="$2"
    env_first=false
  fi
  # Prefer already-set environment variable for service-wide lookups.
  if [ "$env_first" = "true" ] && [ -n "$envvar" ] && [ -n "${!envvar:-}" ]; then
    echo "${!envvar}"
    return
  fi
  local keyring_value=""
  case "$(uname -s)" in
    Darwin) keyring_value="$(security find-generic-password -s "$service" -a "$account" -w 2>/dev/null || true)" ;;
    *)      keyring_value="$(timeout 3s secret-tool lookup service "$service" "$@" 2>/dev/null || true)" ;;
  esac
  if [ -n "$keyring_value" ]; then
    echo "$keyring_value"
    return
  fi
  if [ "$env_first" != "true" ] && [ -n "$envvar" ] && [ -n "${!envvar:-}" ]; then
    echo "${!envvar}"
    return
  fi
}

# Pinned Node path (DES-007: don't rely on PATH in user units).
# Resolve through symlinks so REPO_ROOT points to the actual repo.
# The default Node binary is derived from .nvmrc at runtime so this wrapper
# tracks the repo's single source of truth (see scripts/check-node-pin-consistency.ts).
SCRIPT_DIR="$(cd "$(dirname "$(_resolve_symlinks "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Node-pin resolution + the version-compatibility gate live in a shared library so
# the launch wrapper and the restart-safety pre-flight gate enforce the SAME logic
# (DRY — see deploy/lib/resolve-node.sh). The gate prevents a too-old/too-new Node
# from exec'ing the --experimental-strip-types entrypoint and crash-looping under
# the service manager (incident 2026-05-18 17:12 EDT).
# shellcheck source=deploy/lib/resolve-node.sh
. "$SCRIPT_DIR/lib/resolve-node.sh"
if ! NODE="$(whatsoup_resolve_node "$REPO_ROOT")"; then
  # whatsoup_resolve_node already printed a FATAL line describing the failure.
  exit 1
fi

DATABASE_BOOTSTRAP_TS="$REPO_ROOT/src/database-compatibility-bootstrap.ts"
if [ -L "$DATABASE_BOOTSTRAP_TS" ]; then
  echo "FATAL: unsafe database compatibility entrypoint (must be a regular non-symlink file): $DATABASE_BOOTSTRAP_TS" >&2
  exit 1
fi
if [ ! -e "$DATABASE_BOOTSTRAP_TS" ]; then
  echo "FATAL: database compatibility entrypoint not found: $DATABASE_BOOTSTRAP_TS" >&2
  exit 1
fi
if [ ! -f "$DATABASE_BOOTSTRAP_TS" ]; then
  echo "FATAL: unsafe database compatibility entrypoint (must be a regular non-symlink file): $DATABASE_BOOTSTRAP_TS" >&2
  exit 1
fi

# The compatibility verdict runs before the full restart preflight, so its
# smaller import graph needs an independent trust root. Verify the static
# checker and every local module it executes before asking that checker to walk
# the bootstrap graph. The graph walk reads source only; it never imports or
# evaluates bootstrap modules.
DATABASE_BOOTSTRAP_TRUST_CHECKER="scripts/source-runtime-drift-check.ts"
DATABASE_BOOTSTRAP_TRUST_PATHS=(
  "$DATABASE_BOOTSTRAP_TRUST_CHECKER"
  "scripts/lib/guard-core.ts"
  "src/lib/git-env.ts"
  "src/lib/type-guards.ts"
)
_database_bootstrap_trust_git() (
  while IFS='=' read -r git_env_name _; do
    case "$git_env_name" in
      GIT_*) unset "$git_env_name" ;;
    esac
  done < <(env)
  exec git -C "$REPO_ROOT" "$@"
)
if ! _database_bootstrap_trust_git rev-parse --is-inside-work-tree 2>/dev/null \
  | grep -qx 'true'; then
  echo "FATAL: database bootstrap trust check requires a committed git work tree: $REPO_ROOT" >&2
  exit 1
fi
for trust_path in "${DATABASE_BOOTSTRAP_TRUST_PATHS[@]}"; do
  trust_absolute="$REPO_ROOT/$trust_path"
  if [ -L "$trust_absolute" ] || [ ! -f "$trust_absolute" ] \
    || ! _database_bootstrap_trust_git ls-files --error-unmatch -- "$trust_path" >/dev/null 2>&1 \
    || ! _database_bootstrap_trust_git cat-file -e "HEAD:$trust_path" >/dev/null 2>&1 \
    || ! _database_bootstrap_trust_git diff --quiet HEAD -- "$trust_path"; then
    echo "FATAL: unsafe database bootstrap trust checker path: $trust_absolute" >&2
    echo "       checker closure must be regular non-symlink, tracked, committed, and clean" >&2
    exit 1
  fi
done

if ! (
  cd "$REPO_ROOT"
  "$NODE" \
    --disable-warning=ExperimentalWarning \
    --experimental-strip-types \
    "$REPO_ROOT/$DATABASE_BOOTSTRAP_TRUST_CHECKER" \
    --manifest /dev/stdin >/dev/null <<'JSON'
{
  "schemaVersion": 1,
  "scope": "database-compatibility-bootstrap",
  "entrypoints": [
    {
      "path": "src/database-compatibility-bootstrap.ts",
      "importGraph": true
    }
  ]
}
JSON
); then
  echo "FATAL: database compatibility bootstrap trust check failed" >&2
  exit 1
fi
unset DATABASE_BOOTSTRAP_TRUST_CHECKER DATABASE_BOOTSTRAP_TRUST_PATHS \
  trust_path trust_absolute
unset -f _database_bootstrap_trust_git

# Database compatibility precedes restart preflight, checkout version reporting,
# tmp creation, full config parsing, and every provider credential/keyring lookup.
# A future schema or hot rollback journal enters the dependency-free health
# drain directly, so unrelated startup damage cannot mask the storage verdict.
DATABASE_COMPATIBILITY_PERMANENT_EXIT_STATUS=78
if DATABASE_COMPATIBILITY_STATUS="$(
  "$NODE" \
    --disable-warning=ExperimentalWarning \
    --experimental-strip-types \
    "$DATABASE_BOOTSTRAP_TS" "$INSTANCE" --check
)"; then
  :
else
  DATABASE_COMPATIBILITY_RC=$?
  echo "FATAL: database compatibility preflight failed for instance '$INSTANCE'" >&2
  if [ "$DATABASE_COMPATIBILITY_RC" -eq "$DATABASE_COMPATIBILITY_PERMANENT_EXIT_STATUS" ]; then
    exit "$DATABASE_COMPATIBILITY_PERMANENT_EXIT_STATUS"
  fi
  exit 1
fi
case "$DATABASE_COMPATIBILITY_STATUS" in
  ready) ;;
  future_schema|engine_recovery_required)
    exec "$NODE" \
      --disable-warning=ExperimentalWarning \
      --experimental-strip-types \
      "$DATABASE_BOOTSTRAP_TS" "$INSTANCE" --hold
    ;;
  *)
    echo "FATAL: unrecognized database compatibility status for instance '$INSTANCE'" >&2
    exit 1
    ;;
esac
unset DATABASE_COMPATIBILITY_STATUS DATABASE_COMPATIBILITY_RC \
  DATABASE_COMPATIBILITY_PERMANENT_EXIT_STATUS

# Restart-safety pre-flight gate: probe the live import graph (bootstrap.ts ->
# main.ts -> runtimes/agent/runtime.ts) BEFORE exec'ing node, so a dirty/partial
# tree with a phantom import cannot crash-loop on restart while the old cached
# process was running fine (incidents 2026-06-12: mini1 personal + nucles hub).
# Override for emergencies with WHATSOUP_SKIP_PREFLIGHT=1 (logged when skipped).
if [ "${WHATSOUP_SKIP_PREFLIGHT:-}" = "1" ]; then
  echo "WARN: WHATSOUP_SKIP_PREFLIGHT=1 — restart-safety pre-flight gate BYPASSED for instance '$INSTANCE'" >&2
else
  if ! WHATSOUP_NODE="$NODE" "$SCRIPT_DIR/preflight-check.sh" "$REPO_ROOT" "$INSTANCE"; then
    echo "FATAL: restart-safety pre-flight gate refused to start instance '$INSTANCE' (see PREFLIGHT-FAIL above)." >&2
    echo "       Set WHATSOUP_SKIP_PREFLIGHT=1 to override in an emergency (this is logged)." >&2
    exit 1
  fi
fi

# Expose checkout version metadata to the running instance so /health can report
# the code that was launched. Best-effort only: git failure must not block startup.
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  WHATSOUP_GIT_SHA="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
  _branch="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  WHATSOUP_GIT_BRANCH="${_branch:-HEAD-detached}"
  if printf '%s' "$WHATSOUP_GIT_SHA" | grep -Eq '^[0-9a-f]{40}$'; then
    export WHATSOUP_GIT_SHA
  else
    unset WHATSOUP_GIT_SHA
  fi
  export WHATSOUP_GIT_BRANCH
  unset _branch
else
  unset WHATSOUP_GIT_SHA WHATSOUP_GIT_BRANCH
  echo "WARN: $REPO_ROOT is not a git work tree or git is unavailable; WHATSOUP_GIT_SHA/WHATSOUP_GIT_BRANCH unset" >&2
fi

# Ensure PATH includes locations needed by agent instances (claude CLI, tools)
export PATH="$HOME/.local/bin:$(dirname "$NODE"):$PATH"

# Pin process temp files under a per-instance WhatSoup-owned tmp directory so
# Baileys encrypted upload blobs are not exposed to macOS /var/folders cleanup.
XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
TMPDIR="$XDG_DATA/whatsoup/tmp/$INSTANCE"
mkdir -p "$TMPDIR"
chmod 700 "$TMPDIR"
export TMPDIR

# Detect instance type from instance.json (whatsoup-instances namespace)
XDG_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
INSTANCE_JSON="$XDG_CONFIG/whatsoup/instances/$INSTANCE/config.json"
INSTANCE_TYPE="chat"
if [ -f "$INSTANCE_JSON" ]; then
  INSTANCE_TYPE="$($NODE -e "process.stdout.write(JSON.parse(require('fs').readFileSync('$INSTANCE_JSON','utf8')).type ?? 'chat')")"
fi

if [ "$INSTANCE_TYPE" = "chat" ]; then
  # Chat instances need API keys for direct LLM calls
  ANTHROPIC_API_KEY="$(keyring_lookup anthropic ANTHROPIC_API_KEY)"
  OPENAI_API_KEY="$(keyring_lookup openai OPENAI_API_KEY)"
  PINECONE_API_KEY="$(keyring_lookup pinecone PINECONE_API_KEY)"

  fail_if_empty() {
    local name="$1" val="$2"
    if [ -z "$val" ]; then
      echo "FATAL: $name key is empty or missing from keyring" >&2
      echo "  Linux:  secret-tool store --label='$name' service $name <<<'YOUR_KEY'" >&2
      echo "  macOS:  security add-generic-password -s $name -a \$USER -w 'YOUR_KEY'" >&2
      echo "  Either: export $(echo "$name" | tr '[:lower:]' '[:upper:]')_API_KEY=YOUR_KEY" >&2
      exit 1
    fi
  }

  fail_if_empty "anthropic" "$ANTHROPIC_API_KEY"
  fail_if_empty "openai" "$OPENAI_API_KEY"
  fail_if_empty "pinecone" "$PINECONE_API_KEY"

  export ANTHROPIC_API_KEY OPENAI_API_KEY PINECONE_API_KEY
else
  # Agent and passive instances: no ANTHROPIC_API_KEY (would override subscription billing).
  # OPENAI_API_KEY is needed by agent instances for Whisper audio transcription when users
  # send voice notes. Passive instances don't call any LLM APIs and the key is harmless.
  unset ANTHROPIC_API_KEY 2>/dev/null || true
  OPENAI_API_KEY="$(keyring_lookup openai OPENAI_API_KEY)"
  if [ -n "$OPENAI_API_KEY" ]; then
    export OPENAI_API_KEY
  fi

  # PINECONE_API_KEY is needed by agent instances with pineconeAllowedIndexes for
  # the knowledge_search MCP tool. The tool runs in the WhatSoup process (not the
  # Claude Code subprocess), so the key must be in this parent process.
  PINECONE_API_KEY="$(keyring_lookup pinecone PINECONE_API_KEY)"
  if [ -n "$PINECONE_API_KEY" ]; then
    export PINECONE_API_KEY
  fi
fi

# Health server auth token — used by POST /heal and POST /send on all instances.
# Prefer an already-loaded value (e.g. from EnvironmentFile=tokens.env in the systemd unit) so a
# missing or unresponsive platform keyring cannot delay startup.
#
# W-5 migration: health.ts (line 484) now resolves the token at request time via
# lookupCredential('whatsoup-health-token') — keyring-first, env-fallback (PR #1804).
# This wrapper export is redundant when the token is in the keyring. Once the
# per-instance token is stored in the keyring (service=whatsoup-health-token,
# account=<instance>), this block AND the tokens.env EnvironmentFile line in the
# systemd unit can both be removed. Use deploy/check-health-token-keyring.sh
# <instance> to verify readiness.
# Migration tracking: docs/security-handoffs/2026-05-09-env-secret-exposure.md
# Phase E (W-5).
if [ -z "${WHATSOUP_HEALTH_TOKEN:-}" ]; then
  WHATSOUP_HEALTH_TOKEN="$(keyring_lookup whatsoup-health-token "" user "$INSTANCE")"
  if [ -z "$WHATSOUP_HEALTH_TOKEN" ]; then
    WHATSOUP_HEALTH_TOKEN="$(keyring_lookup whatsoup_health WHATSOUP_HEALTH_TOKEN)"
  fi
fi
if [ -n "$WHATSOUP_HEALTH_TOKEN" ]; then
  export WHATSOUP_HEALTH_TOKEN
fi

# Import-only mode is reserved for deploy/preflight-probe.ts. Never inherit it
# into the real service process: an ambient/systemd value must not turn a valid
# startup into a clean no-op exit under Restart=on-failure.
unset WHATSOUP_PREFLIGHT_IMPORT_ONLY WHATSOUP_PREFLIGHT_IMPORT_SENTINEL

exec "$NODE" \
  --disable-warning=ExperimentalWarning \
  --experimental-strip-types \
  "$REPO_ROOT/src/bootstrap.ts" "$INSTANCE"
