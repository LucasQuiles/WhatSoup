[Unit]
Description=BOT ERRORS remote outbox collector
After=network-online.target bot-errors-dispatcher.service

[Service]
Type=simple
WorkingDirectory=%h/LAB/WhatSoup
EnvironmentFile=%h/.config/whatsoup/bot-errors.env
# Poll list is host-local: set BOT_ERRORS_RELAY_REMOTES=host-a,host-b,... in the
# EnvironmentFile above. Kept out of the tracked unit so fleet topology never
# enters the public repo (see deploy/bot-errors.env.example).
ExecStart=/usr/bin/python3 %h/LAB/WhatSoup/deploy/scripts/bot-errors-collector.py --daemon --interval 30 --max-events 25
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
