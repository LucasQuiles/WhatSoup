# Optional host-specific bind address for whatsoup-fleet.service.
# Copy to ~/.config/whatsoup/fleet.env on hosts that should expose the fleet
# API beyond loopback. Leave unset to bind to 127.0.0.1.
#
# FLEET_BIND_ADDRESS=100.x.y.z
# Non-loopback binds are refused at startup unless you explicitly accept that
# the console HTML serves the root fleet token unauthenticated (B1):
# WHATSOUP_FLEET_UNSAFE_REMOTE_CONSOLE=1
