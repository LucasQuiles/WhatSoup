[Unit]
Description=WhatSoup %i
Wants=network-online.target
After=network-online.target
# 10 crashes in 5 minutes before systemd gives up (was 5 in 2 minutes).
StartLimitIntervalSec=300
StartLimitBurst=10
OnFailure=whatsoup-heal-notify@%i.service

[Service]
EnvironmentFile=-%h/.config/whatsoup/secrets.env
Type=simple
# Pre-install the .nvmrc-pinned Node via nvm if available. No-op on hosts
# without nvm. The wrapper's version gate (deploy/whatsoup, PR #663) is the
# actual safety net at exec time.
#
# Concurrent invocations (multiple template instances starting after reboot)
# share ~/.nvm. nvm has no file locking on version directories. For the
# common case (version already installed) install is a trivial no-op with no
# fs writes. For the cold-boot case (version not present), concurrent
# extracts to ~/.nvm/versions/node/vX.Y.Z/ can race. Risk is accepted: if an
# install fails on one instance the systemd Restart=on-failure picks it up,
# by which point a sibling instance has typically completed the install.
ExecStartPre=%h/.local/bin/whatsoup-ensure-node
ExecStart=%h/.local/bin/whatsoup %i
Restart=on-failure
# Base restart delay — matches Baileys reconnect cooldown.
RestartSec=15
# Exponential backoff: delays increase from RestartSec (15s) toward
# RestartMaxDelaySec (120s) over RestartSteps increments. Prevents burning
# through StartLimitBurst during persistent crash loops.
# Requires systemd 254+. Silently ignored on older versions.
RestartSteps=5
RestartMaxDelaySec=120
# Send SIGTERM only to the main process — it handles child (Claude Code)
# shutdown internally. control-group (default) sends SIGTERM to all cgroup
# members simultaneously, causing a race where child exit events fire before
# session.shutdown() can mark them as clean.
KillMode=mixed
TimeoutStopSec=15
# Load instance-specific tokens (health API auth). The - prefix means
# systemd won't fail if the file is missing (token simply won't be set).
# W-5 migration: once the instance's health token is stored in the OS keyring
# (service=whatsoup-health-token, account=<instance-name>), this line AND the
# wrapper export at deploy/whatsoup:174-182 can both be removed — health.ts
# resolves the token at request time via lookupCredential('whatsoup-health-token').
# Use deploy/check-health-token-keyring.sh <instance> to verify readiness.
# Migration tracking: docs/security-handoffs/2026-05-09-env-secret-exposure.md
# Phase E (W-5). PR #1804 routed the read site through lookupCredential; the
# deploy-side removal (this line + wrapper export) is the remaining W-5 work.
EnvironmentFile=-%h/.config/whatsoup/instances/%i/tokens.env
# Memory limits — each instance runs ~1.5GB normally.
# MemoryHigh triggers kernel reclaim pressure; MemoryMax is the hard OOM cap.
MemoryHigh=4G
MemoryMax=6G

[Install]
# Agent instances must outlive desktop login/logout cycles. Lingered hosts keep
# default.target active without binding the service to GNOME's graphical session.
WantedBy=default.target
