#!/usr/bin/env bash
# WhatSoup entry point (mini27): ensure services + console browser, auto-unlock the
# console session (idempotent — only if not already valid). Machine-local; no clipboard.
# Exits non-zero if the console never came up or the auto-unlock failed.
set -uo pipefail
UID_=$(id -u); FLEET_PORT="${FLEET_PORT:-9227}"; CDP_PORT="${CDP_PORT:-9333}"
LA="$HOME/Library/LaunchAgents"; PROFILE="$HOME/.chrome-console"
RC=0
echo "▶ WhatSoup (mini27)"
for svc in com.whatsoup.whatsoup-fleet com.whatsoup.loops; do
  if launchctl print "gui/$UID_/$svc" >/dev/null 2>&1; then echo "  ✓ $svc running"
  else
    echo "  ↑ starting $svc"; launchctl bootstrap "gui/$UID_" "$LA/$svc.plist" 2>/dev/null || true
    launchctl print "gui/$UID_/$svc" >/dev/null 2>&1 || { echo "  ⚠ $svc FAILED to start"; RC=1; }
  fi
done
printf "  … console"
for i in $(seq 1 24); do curl -s --fail "http://localhost:$FLEET_PORT/" >/dev/null 2>&1 && break; printf "."; sleep 0.5; done
if curl -s --fail "http://localhost:$FLEET_PORT/" >/dev/null 2>&1; then printf " up\n"
else printf " NOT UP\n"; echo "  ✗ fleet console :$FLEET_PORT unreachable"; exit 1; fi
if curl -s --fail "http://localhost:$CDP_PORT/json/version" >/dev/null 2>&1; then
  echo "  ✓ console browser running"
else
  echo "  ↑ launching console browser"
  open -na "Google Chrome" --args --user-data-dir="$PROFILE" --remote-debugging-port="$CDP_PORT" --no-first-run --no-default-browser-check "http://localhost:$FLEET_PORT/" >/dev/null 2>&1 || true
fi
printf "  🔓 session: "
if ! FLEET="http://localhost:$FLEET_PORT" CDP_PORT="$CDP_PORT" "$HOME/.local/bin/whatsoup-console-unlock"; then
  echo "  ⚠ auto-unlock FAILED — open http://localhost:$FLEET_PORT/ and unlock manually"
  RC=1
fi
echo "  🌐 console: http://localhost:$FLEET_PORT/"
exit "$RC"
