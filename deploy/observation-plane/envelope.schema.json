{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsoup://observation-plane/envelope.schema.json",
  "title": "WhatSoup ObservationEnvelope (shadow v0)",
  "description": "One observation: subject + claim + outcome + context + provenance. Shadow v0: additive-only changes until the first pre-registered shadow window completes; v1 promotion requires the shadow exit gate approving the exact schema digest. Missing evidence is never pass and never fail. Raw payloads never appear here: bounded closed classes and sha256 digests only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "envelope_id",
    "run_id",
    "subject",
    "claim_id",
    "adapter_id",
    "outcome",
    "projection",
    "times",
    "authority",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "whatsoup.observation-envelope" },
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]{1,3}$",
      "description": "Shadow v0 series. Bump minor for additive change; any non-additive change requires a versioned migration with fixture replay."
    },
    "envelope_id": { "$ref": "#/$defs/boundedToken" },
    "run_id": { "$ref": "#/$defs/boundedToken" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_subject_id", "binding", "raw"],
      "properties": {
        "canonical_subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(/[a-z0-9][a-z0-9._-]{0,63}){0,2}$",
          "description": "host[/instance[/component]] in canonical form. Synthesis keys ONLY on this id; raw labels are preserved but never joined on."
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "confidence"],
          "properties": {
            "authority": {
              "enum": ["roster", "alias_map", "self_reported", "unresolved"],
              "description": "What resolved the raw labels to the canonical id. 'unresolved' subjects must carry outcome context_mismatch or invalid_evidence and never merge with any other subject."
            },
            "confidence": { "enum": ["exact", "mapped", "ambiguous"] }
          }
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host_label": { "$ref": "#/$defs/boundedLabel" },
            "instance_label": { "$ref": "#/$defs/boundedLabel" },
            "source_label": { "$ref": "#/$defs/boundedLabel" }
          },
          "description": "Verbatim labels as observed. Preserved for audit; never used as a join key."
        }
      }
    },
    "claim_id": {
      "$ref": "#/$defs/dottedId",
      "description": "Must exist in claim-catalog.json (guard-enforced cross-reference)."
    },
    "adapter_id": {
      "$ref": "#/$defs/boundedToken",
      "description": "Must exist in adapter-registry.json and declare this claim in can_establish (guard-enforced)."
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "context_mismatch",
        "stale",
        "unsupported",
        "not_applicable",
        "invalid_evidence",
        "infra_error"
      ]
    },
    "unobserved_reason": {
      "enum": [
        "missing_token",
        "token_rejected",
        "unreachable",
        "unsupported_platform",
        "prerequisite_failed",
        "alias_unresolved",
        "source_unavailable",
        "stale_source",
        "other_bounded"
      ],
      "description": "Required by convention when outcome is inconclusive/unsupported/context_mismatch (guard warns when absent)."
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": { "$ref": "#/$defs/valueRef" },
        "configured": { "$ref": "#/$defs/valueRef" },
        "resolved": { "$ref": "#/$defs/valueRef" },
        "observed": { "$ref": "#/$defs/valueRef" }
      },
      "description": "The four-way quartet. A configured value can never satisfy an observed claim (F10/F18)."
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": { "type": "integer", "minimum": 0 },
        "home_digest": { "$ref": "#/$defs/sha256" },
        "config_root_digest": { "$ref": "#/$defs/sha256" },
        "launch_surface": {
          "enum": ["launchd_agent", "systemd_user", "ssh", "gui", "cron", "manual", "unknown"]
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["node", "python", "shell", "binary", "other"] },
            "version": { "$ref": "#/$defs/boundedLabel" },
            "path_digest": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "description": "The context the probe actually ran in. Serving-vs-probing context inequality yields context_mismatch, never a credential/identity/release failure (F15/F16)."
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "authorization"],
      "properties": {
        "scope": { "enum": ["diagnostic", "public", "unobserved", "not_applicable"] },
        "authorization": {
          "enum": ["token_sent_accepted", "token_sent_rejected", "no_token", "not_applicable"]
        }
      },
      "description": "Which health projection (or equivalent privilege level) the evidence came from. public scope can never support an identity/auth/release verdict (F01 family; guard-checked against the claim's min_projection)."
    },
    "generations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process_pid": { "type": "integer", "minimum": 1 },
        "process_started_at": { "$ref": "#/$defs/isoTime" },
        "config_generation": { "$ref": "#/$defs/boundedLabel" },
        "credential_generation": { "$ref": "#/$defs/boundedLabel" },
        "roster_epoch": { "type": "integer", "minimum": 0 }
      },
      "description": "Evidence binds to generations; it does not survive restart/redeploy/re-pair/roster change (F02/F19)."
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at"],
      "properties": {
        "observed_at": { "$ref": "#/$defs/isoTime" },
        "source_at": { "$ref": "#/$defs/isoTime" },
        "valid_until": { "$ref": "#/$defs/isoTime" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "confidence"],
      "properties": {
        "tier": {
          "enum": [
            "functional_turn",
            "serving_context_canary",
            "authenticated_diagnostic",
            "credential_visibility",
            "configured_presence",
            "declared_intent"
          ]
        },
        "confidence": { "enum": ["confirmed", "inferred", "ambiguous"] }
      },
      "description": "Evidence ordering is claim authority, then context equivalence, then runtime generation, then freshness (F16). Freshness never outranks a context-equal higher tier."
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "satisfied"],
        "properties": {
          "id": { "$ref": "#/$defs/boundedToken" },
          "satisfied": { "type": "boolean" },
          "detail": { "$ref": "#/$defs/boundedLabel" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["file_digest", "event_id", "receipt_digest", "command_capture", "fixture_id"] },
          "digest": { "$ref": "#/$defs/sha256" },
          "ref": { "$ref": "#/$defs/safeRef" }
        }
      },
      "description": "References and digests only — never raw bodies, absolute paths, JIDs, or free text."
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "raw_value", "lossy"],
      "properties": {
        "surface": {
          "enum": [
            "probe_report_verdict",
            "health_poller_classification",
            "watchdog_wd_rank",
            "host_doctor_outcome",
            "fleet_ground_truth_verdict",
            "parity_guard",
            "durable_advance_allowed",
            "bot_errors_event"
          ]
        },
        "raw_value": { "type": "string", "maxLength": 256 },
        "raw_detail": { "type": "string", "maxLength": 512 },
        "lossy": { "type": "boolean" }
      },
      "description": "Verbatim legacy verdict this envelope was projected from (read-side, producers unchanged in shadow). Canonical outcome is a projection; raw_value preserves the original, so nothing is destroyed. raw_detail must already be redacted/bounded before it enters this field."
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 256 },
      "description": "What this observation explicitly cannot establish. Empty array is allowed but must be deliberate."
    }
  },
  "$defs": {
    "boundedToken": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "boundedLabel": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dottedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,31}(\\.[a-z0-9][a-z0-9_]{0,31}){1,3}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "isoTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "safeRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$", "description": "Repo/state-relative reference; never absolute, never contains '..' (guard-checked beyond the pattern)." },
    "valueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "value": { "type": "string", "maxLength": 128, "description": "Bounded closed value only (a version, an enum member, a count). Never a path, JID, token, or message body." },
        "value_digest": { "$ref": "#/$defs/sha256" },
        "value_class": { "$ref": "#/$defs/boundedLabel" }
      }
    }
  }
}
