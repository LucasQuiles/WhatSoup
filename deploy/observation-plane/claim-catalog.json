      "family": "auth_diagnostics",
      "subject_kind": "instance",
      "min_projection": "diagnostic",
      "authority_tier": "authenticated_diagnostic",
      "generation_binding": "process+credential",
      "staleness_rule": { "kind": "event_bound" },
      "producing_adapters": ["auth-health"],
      "cannot_establish": ["incident.recovery_verified"]
    },
    {
      "claim_id": "db.durability_status",
