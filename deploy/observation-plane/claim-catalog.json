{
  "schema": "whatsoup.observation-claim-catalog",
  "schema_version": "0.1",
  "description": "Closed catalog of claims the observation plane may evaluate. Every envelope's claim_id must exist here. min_projection is the weakest health projection (or equivalent privilege) that may support a non-inconclusive verdict for the claim (a public projection never supports a privileged verdict). staleness_rule is claim-specific: flat legacy constants (30min producer / 2h fleet-ground-truth) are comparison inputs only, never authoritative; scheduler_deadline defers to the producer's scheduler-derived evidence-deadline semantics (expectedProbeDeadlineMs).",
  "authority_tiers_ref": "authority-lattice.json",
  "claims": [
    {
      "claim_id": "transport.http_liveness",
      "family": "transport_liveness",
      "subject_kind": "instance",
      "min_projection": "public",
      "authority_tier": "authenticated_diagnostic",
      "generation_binding": "process",
      "staleness_rule": { "kind": "event_bound", "note": "valid only for the observed response instant" },
      "producing_adapters": ["public-liveness", "auth-health"],
      "cannot_establish": ["identity.instance_name", "auth_bond.status", "provider.diagnostic_status", "release.executing_release"]
    },
    {
