      "generation_binding": "process",
      "staleness_rule": { "kind": "scheduler_deadline", "note": "producer-owned freshness (expectedProbeDeadlineMs; the diagnostic body publishes the effective window as model_usable_freshness_ms); consumer-side flat windows are legacy comparison inputs only" },
      "producing_adapters": ["auth-health"],
      "cannot_establish": ["provider.functional_turn"]
    },
    {
      "claim_id": "provider.functional_turn",
      "family": "provider_functional",
      "subject_kind": "instance",
      "min_projection": "not_applicable",
      "authority_tier": "functional_turn",
