      "producing_adapters": ["provider-turn"],
      "cannot_establish": []
    },
    {
      "claim_id": "delivery.provider_ack",
      "family": "delivery",
      "subject_kind": "instance",
      "min_projection": "diagnostic",
      "authority_tier": "functional_turn",
