#!/usr/bin/env sh
set -e

# Fail-closed commit-identity mandate (strict allowlist). Runs first and cheap so
# a rogue author/committer (e.g. the historical `whatsoup-bot`) is rejected before
# the commit object is written. Self-contained — see .husky/check-commit-identity.sh.
./.husky/check-commit-identity.sh

npm run guard:repo:staged

# Sub-second deterministic guards — no console deps required, always run.
npm run guard:publication:staged
npm run guard:design-system-hygiene
npm run guard:node-pin-consistency
npm run guard:claude-settings
npm run guard:no-destructive-git

# qSesh Python lane — only when qSesh, package, hook, or workflow surfaces are
# staged. Fail-closed: set -e above makes any lint/test failure block the commit.
if git diff --cached --name-only | grep -Eq '^tools/qsesh/|^scripts/run-qsesh-pytests\.sh$|^package\.json$|^\.husky/|^\.github/workflows/quality\.yml$'; then
  npm run lint:qsesh
  npm run test:qsesh
fi

# Theme parity only when token file is staged — avoids console dep for unrelated commits.
if git diff --cached --name-only | grep -q 'console/src/styles/tokens\.semantic\.css'; then
  npm --prefix console run design:theme-parity
fi

if git diff --cached --name-only -- console/src | grep -Eq '\.(ts|tsx)$'; then
  if [ ! -x console/node_modules/.bin/lint-staged ] || [ ! -x console/node_modules/.bin/eslint ]; then
    echo "console lint dependencies are missing; run: cd console && npm ci" >&2
    exit 1
  fi

  (cd console && ./node_modules/.bin/lint-staged)
fi

# Early architectural-drift signal — WARN-ONLY. The pre-push chain
# (verify:push:branch) hard-enforces these same guards; this surfaces drift at
# commit time so it is not discovered only at push. Never aborts the commit.
# Skip with WHATSOUP_SKIP_DRIFT_WARN=1 for fast local iteration.
if [ -z "$WHATSOUP_SKIP_DRIFT_WARN" ] && \
   git diff --cached --name-only | grep -Eq '\.tsx?$|^package\.json$|^\.nvmrc$|^deploy/'; then
  drift_warn() {
    if ! _out=$(npm run "$1" 2>&1); then
      printf '  ⚠ %s drift (warn-only; pre-push enforces) — run: npm run %s\n' "$2" "$1" >&2
    fi
  }
  printf '── architectural-drift check (warn-only) ──\n' >&2
  drift_warn guard:node-pin-consistency 'node-pin'
  drift_warn guard:boundaries 'ring-boundary'
  drift_warn guard:lint:src 'fitness/emitter'
fi
