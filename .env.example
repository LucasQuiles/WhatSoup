# WhatSoup Docker Environment
# Copy to .env and fill in values: cp .env.example .env

# ── Instances ────────────────────────────────────────────────────────────────
# Comma-separated list of instance names to start in supervisor mode.
# Each instance must have a config.json in the config volume at:
#   instances/<name>/config.json
WHATSOUP_INSTANCES=

# ── API Keys ─────────────────────────────────────────────────────────────────
# Required for chat instances (direct LLM API calls)
ANTHROPIC_API_KEY=
# Required for audio transcription (Whisper) and LLM fallback
OPENAI_API_KEY=
# Required for memory/entity search pipeline
PINECONE_API_KEY=

# ── Memory Recency Decay ──────────────────────────────────────────────
# Ebbinghaus-style exponential forgetting applied to pinecone search results.
# Defaults are sensible for chat-memory; adjust if you observe poor recall on
# stale-but-relevant records or excessive surfacing of fresh-but-noisy ones.
# Half-life in days for the exponential decay function. Smaller = faster forgetting.
RECENCY_HALF_LIFE_DAYS=14
# Maximum age in days. Records older than this are filtered out of search results.
MAX_AGE_DAYS=90

# ── Health & Security ────────────────────────────────────────────────────────
# Bearer token for POST /send and POST /heal endpoints.
# Generate with: openssl rand -hex 32
WHATSOUP_HEALTH_TOKEN=

# ── Fleet Server ─────────────────────────────────────────────────────────────
FLEET_PORT=9099

# ── Outbound client-safety (audience tiers) ──────────────────────────────────
# Outbound agent text is scrubbed of operator-local artifacts before it reaches
# the recipient. The scrub is scaled to the target chat's audience:
#   • client (default) — full scrub: secrets/emails + operator paths, runtime
#     identifiers (.claude/, hook-event names), tailnet IPs.
#   • internal         — secrets/emails only; the fleet's own coordination
#     vocabulary (paths, hook names, bead `Files:` lists) is legitimate content.
#   • ops              — verbatim (the BOT_ERRORS_JID diagnostics channel).
# WHATSOUP_INTERNAL_JIDS: comma-separated group JIDs to treat as `internal`
# (operator-owned agent-coordination groups). Leave empty to scrub every chat as
# a client. Example: 120363...@g.us,120363...@g.us
WHATSOUP_INTERNAL_JIDS=
# BOT_ERRORS_JID: the ops diagnostics group JID (verbatim, never scrubbed).
BOT_ERRORS_JID=

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Auth Helper ──────────────────────────────────────────────────────────────
# Instance name for: docker compose run --rm auth
AUTH_INSTANCE=
